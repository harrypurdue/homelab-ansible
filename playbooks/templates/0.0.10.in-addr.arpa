@       IN      SOA     dns-01.lab.lan. hostmaster.lab.lan.     (
{{ansible_date_time.epoch}}     ;serial
12h                             ;refresh
15m                             ;retry
3w                              ;expiry
2h                              ;minimum
)
 
0.0.10.in-addr.arpa.                   IN      NS      ns1.lab.lan.
0.0.10.in-addr.arpa.                   IN      NS      ns2.lab.lan.
 
51               IN      PTR     staging-01.lab.lan.
101               IN      PTR     dns-01.lab.lan.
102               IN      PTR     dns-02.lab.lan.
103               IN      PTR     cml-01.lab.lan.
104               IN      PTR     ca-01.lab.lan.
105               IN      PTR     zabbix-01.lab.lan.
106               IN      PTR     docker-01.lab.lan.
107               IN      PTR     docker-02.lab.lan.
11               IN      PTR     r1.lab.lan.
12               IN      PTR     r2.lab.lan.
13               IN      PTR     r3.lab.lan.
14               IN      PTR     r4.lab.lan.