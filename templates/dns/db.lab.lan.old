; base zone file for lab.lan

$TTL 2d	; default TTL for zone

$ORIGIN lab.lan. ; base domain-name

; Start of Authority RR defining the key characteristics of the zone (domain)

@     	IN  	SOA   dns-01.lab.lan. admin.lab.lan. (

                            	{{ansible_date_time.epoch}} ; serial number

                            	12h    	; refresh

                            	15m    	; update retry

                            	3w     	; expiry

                            	60s     ; minimum

                            	)

; name server RR for the domain

       	IN  	NS  	dns-01.lab.lan.
       	IN  	NS  	dns-02.lab.lan.

; records for domain
pve    	IN  	A   	192.168.0.200
dns-01    	IN  	A   	10.0.0.101	
dns-02    	IN  	A   	10.0.0.102	
gns03-01    	IN  	A   	10.1.0.203
radius-01	IN	A	10.0.0.110
pfsense-01	IN	A	192.168.0.253
ca-01		IN	A	10.0.0.104
zabbix-01	IN	A	10.0.0.105
lab.lan.	IN 	CAA	0 issue "ca-01.lab.lan"
docker-01	IN	A	10.0.0.106
docker-02	IN	A	10.0.0.107
staging-01	IN	A	10.0.0.51
staging-02	IN	A	10.0.0.52
cml-01		IN	A	10.0.0.103
r1	IN	A	10.0.0.11
r2	IN	A	10.0.0.12
r3	IN	A	10.0.0.13
r4	IN	A	10.0.0.14

; ftp    	IN  	CNAME   ftp.example.net.
ns1 IN CNAME dns-01
ns2 in CNAME dns-02
ejbca-node1	IN CNAME ca-01
